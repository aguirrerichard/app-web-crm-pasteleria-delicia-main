# Copia este archivo como .env y pon TUS datos (el .env nunca se sube a GitHub)
PORT=3000
# Cadena de conexión de Neon (Dashboard > Connect)
DATABASE_URL=postgresql://usuario:clave@host.neon.tech/neondb?sslmode=require
# true para Neon; false si usas PostgreSQL local
DB_SSL=true
# Cualquier texto largo y secreto (firma los tokens de sesión)
JWT_SECRET=cambia-esto-por-un-texto-largo-y-secreto
JWT_EXPIRES=8h
# Frontends autorizados (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
